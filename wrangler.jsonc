  },
  "routes": [
    { "pattern": "rankrun.com.br", "custom_domain": true },
    { "pattern": "www.rankrun.com.br", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rankrun-db",
      "database_id": "3e86b168-9ce1-4437-9e2c-e9df9dab17e0"
    }
  ]
}
