{
  "name": "rankrun",
  "account_id": "4486f5377d83216c279533b9c55905fc",
  "compatibility_date": "2024-12-18",
  "compatibility_flags": ["nodejs_compat"],
  "main": ".open-next/worker.js",
  "assets": {
    "directory": ".open-next/assets"
  },
  "vars": {
